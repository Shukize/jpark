# ── J Park Hotel API — environment ───────────────────────────────────────────
# Copy to backend/.env for local dev. In production these are set in the
# Render dashboard (Environment tab), NEVER committed.

# Local dev points at a local Postgres; production uses the Neon connection string.
DATABASE_URL=postgresql://jpark:password@localhost:5432/jpark
NODE_ENV=development
PORT=3000
FRONTEND_ORIGIN=http://localhost:5500

# Shared secret for the OTA intake endpoints (/api/v1/ota-sync, /api/v1/ota-email,
# POST /api/guest-bookings). The channel manager / email-forwarding bridge sends it
# as the X-API-Key header (ota-email also accepts it as a ?key= query param).
OTA_WEBHOOK_SECRET=change-me-to-a-long-random-string

# Where new-booking notices are emailed (the hotel's reservations inbox).
# Comma-separate for multiple recipients. Defaults to jparkhotel1@gmail.com.
HOTEL_NOTIFY_EMAIL=jparkhotel1@gmail.com

# Server-side JWT signing secret. Use a long random string in production.
# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_TOKEN_SECRET=change-me-to-a-long-random-string

# Transactional email (Resend — https://resend.com). Leave blank to disable sending.
RESEND_API_KEY=
# Until you verify your own domain in Resend, use the sandbox sender onboarding@resend.dev
EMAIL_FROM=J Park Hotel <onboarding@resend.dev>

# ── Online booking payments (Omise / Opn Payments) ────────────────────────
# Payment is a hybrid, per-booking choice: pay at check-in (the default, and
# the ONLY option while these are blank) or pay online now by card or
# PromptPay QR. Leave them blank to keep online payment disabled — the
# booking page falls back to pay-at-checkin-only with zero visible change.
# See docs/PAYMENTS_SETUP.md for the signup runbook and go-live steps.
#
# These two keys are the whole switch. The gateway is auto-detected from
# whichever keys are present, so nothing else has to be set to go live.
# Start with the Test-mode pair (pkey_test_… / skey_test_…).
OMISE_PUBLIC_KEY=
OMISE_SECRET_KEY=

# Where a guest returns after a 3-D Secure card challenge (the PUBLIC site),
# and where the gateway sends its server-to-server notification (this API).
# On Render, PUBLIC_API_URL is unnecessary — RENDER_EXTERNAL_URL is injected.
PUBLIC_SITE_URL=http://localhost:5500
PUBLIC_API_URL=http://localhost:3000

# Appended as ?key=... to the webhook URL registered with Omise, and also
# unlocks the browser-openable form of GET /api/v1/payments/diagnostics.
# Every webhook is re-verified against Omise's API regardless, so this is a
# secondary guard — but set it: without it, diagnostics needs an admin session.
PAYMENT_WEBHOOK_SECRET=

# Optional. The webhook secret from the Omise dashboard's Webhooks page
# (base64). When set, each delivery's Omise-Signature header is verified with
# HMAC-SHA256 over "<timestamp>.<raw body>" before anything else runs, so a
# forged post is rejected without costing an API call. Test and live modes
# have SEPARATE secrets.
OMISE_WEBHOOK_SIGNING_SECRET=

# The live gateway. Pinned to Omise, the hotel's approved acquirer, so it can
# never be decided by whichever keys happen to be present.
PAYMENT_PROVIDER=omise

# GB Prime Pay is NOT in use. Omise is the hotel's acquirer; this adapter
# stays as a tested fallback only. Three keys with three different jobs (public = browser tokenization,
# secret = charge/status, token = QR Cash). Setting these switches acquirer
# with no code change. https://doc.gbprimepay.com
GBPRIMEPAY_PUBLIC_KEY=
GBPRIMEPAY_SECRET_KEY=
GBPRIMEPAY_TOKEN_KEY=
# "sandbox" (default) → api.globalprimepay.com, no real money moves.
# "live"              → api.gbprimepay.com, real money moves.
GBPRIMEPAY_ENV=sandbox
GBPRIMEPAY_3DS=true
