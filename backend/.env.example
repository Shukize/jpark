# ── J Park Hotel API — environment ───────────────────────────────────────────
# Copy to backend/.env for local dev. In production these are set in the
# Render dashboard (Environment tab), NEVER committed.

# Local dev points at a local Postgres; production uses the Neon connection string.
DATABASE_URL=postgresql://jpark:password@localhost:5432/jpark
NODE_ENV=development
PORT=3000
FRONTEND_ORIGIN=http://localhost:5500

# Shared secret for the OTA intake endpoints (/api/v1/ota-sync, /api/v1/ota-email,
# POST /api/guest-bookings). The channel manager / email-forwarding bridge sends it
# as the X-API-Key header (ota-email also accepts it as a ?key= query param).
OTA_WEBHOOK_SECRET=change-me-to-a-long-random-string

# Where new-booking notices are emailed (the hotel's reservations inbox).
# Comma-separate for multiple recipients. Defaults to jparkhotel1@gmail.com.
HOTEL_NOTIFY_EMAIL=jparkhotel1@gmail.com

# Server-side JWT signing secret. Use a long random string in production.
# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_TOKEN_SECRET=change-me-to-a-long-random-string

# Transactional email (Resend — https://resend.com). Leave blank to disable sending.
RESEND_API_KEY=
# Until you verify your own domain in Resend, use the sandbox sender onboarding@resend.dev
EMAIL_FROM=J Park Hotel <onboarding@resend.dev>

# Online booking payments (Omise / Opn Payments — https://www.omise.co).
# Leave both blank to keep online payment disabled (the booking page falls
# back to its existing call/email note). Use the pkey_test_.../skey_test_...
# values from your Omise dashboard's Test mode first — see docs/PAYMENTS_SETUP.md.
OMISE_PUBLIC_KEY=
OMISE_SECRET_KEY=
# Optional: appended as ?key=... to the webhook URL you register in Omise's
# dashboard. Every webhook is re-verified against the Omise API regardless.
OMISE_WEBHOOK_SECRET=
